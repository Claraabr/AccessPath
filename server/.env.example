PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/accesspath
JWT_SECRET=replace-with-a-long-random-string
# Address of the client allowed to call the API, no / at the end: the Vercel URL online,
# or the address Vite shows when you start the client on your computer. Several with commas
CLIENT_ORIGIN=
